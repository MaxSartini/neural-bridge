# Neural Bridge configuration template
# Copy to .env for local use. .env is ignored by git.

# Flask API
SECRET_KEY=change-me-local-only
FLASK_DEBUG=true
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# External asset root
# Store model weights, Hugging Face caches, VEATIC data, TRIBE caches, and large outputs outside git.
NEURAL_BRIDGE_EXTERNAL_ROOT=/path/to/neural-bridge-assets
HF_HOME=${NEURAL_BRIDGE_EXTERNAL_ROOT}/cache/huggingface
TMPDIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/tmp

# TRIBE runtime
NEURO_PRIOR_MODE=apple_silicon_tribe
NEURO_PRIOR_STRICT=false
NEURO_PRIOR_SAVE_RAW_OUTPUT=true
TRIBE_MODEL_ID=facebook/tribev2
TRIBE_APPLE_SILICON_SOURCE_DIR=./external_models/tribev2-apple-silicon
TRIBE_CACHE_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/cache/tribev2
TRIBE_DEVICE=auto
TRIBE_TEXT_EVENTS_DIRECT=true
TRIBE_WHISPERX_MODEL=small
TRIBE_WHISPERX_BATCH_SIZE=4
TRIBE_TRANSCRIPTION_BACKEND=mlx
TRIBE_MLX_WHISPER_MODEL=mlx-community/whisper-small-mlx

# Optional TRIBE-MLX head
TRIBE_MLX_MODEL_ID=zimengxiong/tribev2-mlx
TRIBE_MLX_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/models/tribe-mlx/zimengxiong-tribev2-mlx
TRIBE_MLX_ENABLED=true

# Upstream feature extractors
TRIBE_TEXT_ENCODER_ID=meta-llama/Llama-3.2-3B
TRIBE_TEXT_ENCODER_LOCAL_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/models/upstream-encoders/meta-llama-Llama-3.2-3B
TRIBE_TEXT_ENCODER_MLX_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/models/upstream-encoders-mlx/meta-llama-Llama-3.2-3B
TRIBE_AUDIO_ENCODER_ID=facebook/w2v-bert-2.0
TRIBE_AUDIO_ENCODER_LOCAL_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/models/upstream-encoders/facebook-w2v-bert-2.0
TRIBE_VIDEO_ENCODER_ID=facebook/vjepa2-vitg-fpc64-256
TRIBE_VIDEO_ENCODER_LOCAL_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/models/upstream-encoders/facebook-vjepa2-vitg-fpc64-256
TRIBE_VIDEO_ENCODER_BACKEND=mlx
TRIBE_VIDEO_ENCODER_MLX_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/models/upstream-encoders-mlx/facebook-vjepa2-vitg-fpc64-256
TRIBE_VIDEO_DEVICE=auto
TRIBE_ALLOW_UNSAFE_VITG_MPS=false
TRIBE_MPS_MEMORY_FRACTION=0.70
TRIBE_TEXT_BATCH_SIZE=4
TRIBE_VIDEO_DTYPE=float16
TRIBE_VIDEO_NUM_FRAMES=32
TRIBE_VIDEO_WINDOW_CACHE_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/cache/tribev2/video_windows

# Apple Silicon runtime safety
TRIBE_MPS_CHUNKED_ATTENTION=true
TRIBE_MPS_ATTENTION_QUERY_CHUNK_SIZE=8
TRIBE_VJEPA_SELECTIVE_HIDDEN_STATES=true
PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.88
PYTORCH_MPS_LOW_WATERMARK_RATIO=0.78
PYTORCH_ENABLE_MPS_FALLBACK=1
