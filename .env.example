# =============================================================
# Neural Bridge Configuration
# =============================================================
# This fork runs entirely on local models — no cloud APIs needed.
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== LM Studio local Qwen inference engine =====
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL_NAME=
# Set this to the exact Qwen 3.6 27B model name shown by LM Studio when known.

# ===== Neuro-prior system =====
NEURO_PRIOR_MODE=apple_silicon_tribe
NEURO_PRIOR_STRICT=false
NEURO_PRIOR_FALLBACK_TO_PROXY=true
NEURO_PRIOR_SAVE_RAW_OUTPUT=true
NEURO_PRIOR_BACKEND_PRIORITY=apple_silicon_tribe,tribe_mlx,proxy,disabled
NEURO_PRIOR_IN_PERSONA_PROMPTS=false
NEURO_PRIOR_IN_CONFIG_PROMPTS=false
NEURO_PRIOR_CAN_OVERRIDE_STANCE=false
NEURO_PRIOR_SHARED_SENTIMENT_SHIFT=false
NEURO_HEURISTIC_MODIFIERS_ACTIVE=false

# ===== Official TRIBE v2 =====
TRIBE_MODEL_ID=facebook/tribev2
NEURAL_BRIDGE_EXTERNAL_ROOT=/path/to/neural-bridge-assets
TRIBE_CACHE_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/cache/tribev2
TRIBE_DEVICE=auto
TRIBE_TEXT_EVENTS_DIRECT=true
TRIBE_WHISPERX_MODEL=small
TRIBE_WHISPERX_BATCH_SIZE=4
# Apple Silicon default: Metal-accelerated transcription with word timestamps.
# WhisperX/CTranslate2 does not support MPS; set whisperx only for CPU alignment.
TRIBE_TRANSCRIPTION_BACKEND=mlx
TRIBE_MLX_WHISPER_MODEL=mlx-community/whisper-small-mlx

# ===== Local TRIBE source paths =====
TRIBE_APPLE_SILICON_SOURCE_DIR=./external_models/tribev2-apple-silicon

# ===== TRIBE-MLX optional backend =====
TRIBE_MLX_MODEL_ID=zimengxiong/tribev2-mlx
TRIBE_MLX_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/models/tribe-mlx/zimengxiong-tribev2-mlx
TRIBE_MLX_ENABLED=true

# ===== Upstream TRIBE feature extractors =====
TRIBE_TEXT_ENCODER_ID=meta-llama/Llama-3.2-3B
TRIBE_TEXT_ENCODER_LOCAL_DIR=./models/upstream-encoders/meta-llama-Llama-3.2-3B
TRIBE_TEXT_ENCODER_MLX_DIR=~/.lmstudio/models/mlx-community/Llama-3.2-3B-Instruct-4bit
TRIBE_AUDIO_ENCODER_ID=facebook/w2v-bert-2.0
TRIBE_AUDIO_ENCODER_LOCAL_DIR=./models/upstream-encoders/facebook-w2v-bert-2.0
TRIBE_VIDEO_ENCODER_ID=facebook/vjepa2-vitg-fpc64-256
TRIBE_VIDEO_ENCODER_LOCAL_DIR=./models/upstream-encoders/facebook-vjepa2-vitg-fpc64-256
TRIBE_VIDEO_ENCODER_MLX_DIR=${NEURAL_BRIDGE_EXTERNAL_ROOT}/models/upstream-encoders-mlx/facebook-vjepa2-vitg-fpc64-256
TRIBE_VIDEO_DEVICE=auto
TRIBE_ALLOW_UNSAFE_VITG_MPS=false
TRIBE_MPS_MEMORY_FRACTION=0.70
TRIBE_VIDEO_DTYPE=float16
TRIBE_VIDEO_NUM_FRAMES=32
PYTORCH_MPS_HIGH_WATERMARK_RATIO=0.88
PYTORCH_MPS_LOW_WATERMARK_RATIO=0.78
PYTORCH_ENABLE_MPS_FALLBACK=1
# Apple Silicon note: Torch MPS is available, but the current TRIBE Apple branch is more reliable on CPU.
# Keep NEURO_PRIOR_FALLBACK_TO_PROXY=true unless your Hugging Face account has access to the gated text encoder.
# LM Studio GGUF downloads are not enough for TRIBE's exact extractor; TRIBE needs a HF Transformers model folder.

# Older Ollama-compatible local defaults:
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_NAME=qwen2.5:32b

# ===== Neo4j Configuration =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neural_bridge

# ===== Embedding Configuration =====
# Uses Ollama's embedding endpoint
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Points to same local Ollama server
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# Local OASIS simulation controls. One model call at a time is safest for a
# local 27B model; lower sampling variance improves repeatable calibration.
OASIS_ENV_SEMAPHORE=1
OASIS_SERIAL_PLATFORMS=true
OASIS_MAX_ACTIVE_AGENTS_PER_ROUND=8
OASIS_RANDOM_SEED=33
OASIS_LLM_TEMPERATURE=0.6
OASIS_LLM_TOP_P=0.9
OASIS_NEURO_PRIOR_IN_ROUND_PROMPTS=false
