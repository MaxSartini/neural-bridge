{
  "name": "dashboard-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:scorecard": "vite build --config vite.static.config.ts && node ../scripts/verify-bundle.mjs dist-scorecard --profile internal",
    "preview:scorecard": "wrangler pages dev dist-scorecard --port 4321 --ip 127.0.0.1 --compatibility-date=2026-05-03",
    "deploy:scorecard": "npm run build:scorecard && wrangler pages deploy dist-scorecard --project-name neural-bridge-scorecard",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dashboard/shared": "*",
    "@dashboard/ui": "*",
    "lucide-react": "^1.31.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-json-view-lite": "^1.5.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^4.86.0"
  }
}
