# Cloudflare Pages reads this file from the build output root.
#
# The scorecard bundle is fully self-contained: it loads no third-party script,
# no remote font, no remote image, and makes no network request at runtime.
# That lets the policy below be genuinely strict rather than nominal.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

# Hashed assets are immutable; the HTML entry must not be cached, so a redeploy
# is visible immediately rather than after a stale-cache window.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pages serves index.html at "/", so the rule has to match that path too.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
