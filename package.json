{
  "name": "neural-bridge",
  "version": "0.2.0",
  "private": true,
  "description": "Neural Bridge VEATIC/TRIBE research workspace",
  "scripts": {
    "setup": "npm --prefix frontend install",
    "setup:backend": "cd backend && uv sync --extra research-tooling",
    "setup:frontend": "npm --prefix frontend install",
    "setup:all": "npm run setup && npm run setup:backend",
    "backend": "cd backend && uv run python run.py",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "audit:repo": "python3 backend/scripts/audit_repo_readiness.py",
    "audit:codex-desktop": "python3 tools/audit_codex_desktop_workflow.py",
    "evidence:freeze": "python3 backend/scripts/freeze_veatic_v2_evidence.py --create-snapshot",
    "evidence:verify": "python3 backend/scripts/freeze_veatic_v2_evidence.py --verify",
    "test": "python3 -m pytest -q tests",
    "test:contracts": "python3 -m pytest -q tests",
    "verify:research-tooling": "cd backend && uv run --extra research-tooling python scripts/verify_research_tooling_integrations.py",
    "verify:deployment-stage0": "python3 -m pytest -q tests/test_again_zero_label_deployment_stage0.py",
    "verify:deployment-stage-a": "python3 -m pytest -q tests/test_again_zero_label_deployment_stage0.py tests/test_again_zero_label_deployment_stage_a.py && python3 backend/scripts/run_again_dense_2hz_zero_label_deployment_stage_a.py --dry-run >/dev/null",
    "verify:deployment-locked-confirm": "python3 -m pytest -q tests/test_again_zero_label_deployment_stage0.py tests/test_again_zero_label_deployment_stage_a.py tests/test_again_zero_label_direct_supervised_locked_confirmation.py && python3 backend/scripts/run_again_dense_2hz_zero_label_direct_supervised_locked_confirmation.py --dry-run >/dev/null",
    "verify": "npm run audit:repo && python3 -m compileall -q backend/app backend/scripts external_models/tribev2-apple-silicon/tribev2 tests && npm test && python3 backend/scripts/run_veatic_strict_benchmark.py --dry-run --primary-only >/dev/null && npm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "license": "AGPL-3.0"
}
