# Neural Bridge ignore rules

# Local secrets and machine-specific config
.env
.env.*
!.env.example
*.local

# OS and editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Python environments, caches, and build output
.venv/
venv/
ENV/
backend/.venv/
backend/venv*/
.python-version
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Node/Vite dependencies and build output
node_modules/
/package-lock.json
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs and local runtime output
*.log
logs/
log/
backend/logs/
backend/log/
backend/uploads/
backend/tmp/

# Heavy model and cache artifacts
models/*
!models/neuro_atlases/
!models/neuro_atlases/**
cache/
external_assets/
benchmarks/cache/
benchmarks/results/
*.ckpt
*.pt
*.pth
*.safetensors
*.npz
*.npy
*.parquet
*.mp4
*.mov
*.mkv
*.avi
*.wav
*.mp3

# Generated benchmark output. Curated lightweight evidence reports may be
# force-added when they are part of the documented v2 evidence bundle.
outputs/
reports/*.csv
reports/*.jsonl
reports/*.parquet
reports/*.npz

# Local runtime volumes
data/

# Local scratch folders
tmp/
scratch/
mydoc/
mytest/

# Local agent/tooling caches
.cache/
.tools/
.codebase-memory/
