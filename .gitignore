# Heavy and machine-local artifacts live behind one external boundary.
/artifacts

# Migration and local working state.
/.migration-work
/.scratch
/.cache
/graphify-out

# Environments, dependencies, and generated builds.
/.venv
**/__pycache__
**/node_modules
**/dist
**/build

# Host noise.
.DS_Store

# Wrangler CLI local state, not source. Never commit: besides the Cloudflare
# account id, `cache/cf.json` records the developer's city, postal code and
# latitude/longitude, and `tmp/` retains bundled worker sources with absolute
# local paths. Unanchored so it catches the copies nested in workspaces.
**/.wrangler/
